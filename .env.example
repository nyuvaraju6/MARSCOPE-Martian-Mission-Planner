# NASA_API_KEY: Optional API key for NASA Open APIs (https://api.nasa.gov/).
# Defaults to DEMO_KEY on the server if unset (rate-limited by NASA).
NASA_API_KEY="DEMO_KEY"

# GEMINI_API_KEY: Optional Gemini API key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
